{
  "$id": "https://binreaper.local/schemas/atlas-production-todo-registry-v2.0.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assumptions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "evidence_searched": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "id": {
            "pattern": "^A[1-9][0-9]*$",
            "type": "string"
          },
          "resolving_artifact": {
            "minLength": 1,
            "type": "string"
          },
          "statement": {
            "minLength": 1,
            "type": "string"
          },
          "validation_task_id": {
            "pattern": "^T[1-9][0-9]*(?:\\.[1-9][0-9]*){2,}$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "statement",
          "evidence_searched",
          "resolving_artifact",
          "validation_task_id"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "authorities": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "class": {
            "enum": [
              "plan",
              "code",
              "architecture",
              "fleet",
              "security",
              "testing",
              "deployment",
              "governance",
              "knowledge",
              "external"
            ]
          },
          "commit": {
            "type": "string"
          },
          "decision": {
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "pattern": "^AUTH-[A-Z0-9-]+$",
            "type": "string"
          },
          "limitations": {
            "type": "string"
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "repository": {
            "type": "string"
          },
          "status": {
            "enum": [
              "found",
              "unresolved",
              "conflicting"
            ]
          }
        },
        "required": [
          "id",
          "class",
          "repository",
          "commit",
          "path",
          "decision",
          "status",
          "limitations"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "conflicts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^C[1-9][0-9]*$",
            "type": "string"
          },
          "resolution_task_id": {
            "pattern": "^T[1-9][0-9]*(?:\\.[1-9][0-9]*){2,}$",
            "type": "string"
          },
          "safest_interpretation": {
            "minLength": 1,
            "type": "string"
          },
          "sources": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 2,
            "type": "array"
          },
          "statement": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "sources",
          "statement",
          "safest_interpretation",
          "resolution_task_id"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "domains": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "minLength": 1,
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "token": {
            "pattern": "^\\{[A-Z0-9_]+\\}$",
            "type": "string"
          }
        },
        "required": [
          "token",
          "name",
          "description"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "epics": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "epic_id": {
            "pattern": "^E[1-9][0-9]*$",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "objective": {
            "minLength": 1,
            "type": "string"
          },
          "task_ids": {
            "items": {
              "pattern": "^T[1-9][0-9]*(?:\\.[1-9][0-9]*){2,}$",
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "epic_id",
          "name",
          "objective",
          "task_ids"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "evidence_mode": {
      "enum": [
        "ACTIVE-WORKSPACE",
        "ATTACHED-SNAPSHOT",
        "CONNECTED-REPOSITORY",
        "SOURCE-ONLY"
      ]
    },
    "generator_version": {
      "minLength": 1,
      "type": "string"
    },
    "master_plan": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "constraints": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "delivery_sequence": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "objective": {
          "minLength": 1,
          "type": "string"
        },
        "scope": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "trust_boundaries": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "unresolved_decisions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "objective",
        "scope",
        "architecture",
        "trust_boundaries",
        "constraints",
        "delivery_sequence",
        "unresolved_decisions"
      ],
      "type": "object"
    },
    "part1_header_source": {
      "minLength": 1,
      "type": "string"
    },
    "planning_root": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "slug": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "source_repositories": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "access_mode": {
            "enum": [
              "local",
              "connector",
              "snapshot",
              "source-only"
            ]
          },
          "commit": {
            "pattern": "^[0-9a-f]{40}$",
            "type": "string"
          },
          "repository": {
            "minLength": 1,
            "type": "string"
          },
          "role": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "repository",
          "commit",
          "role",
          "access_mode"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "target_plan_path": {
      "minLength": 1,
      "type": "string"
    },
    "target_repository": {
      "minLength": 1,
      "type": "string"
    },
    "tasks": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "acceptance_criteria": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 5,
            "minItems": 2,
            "type": "array"
          },
          "affected_components": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "disposition": {
                  "enum": [
                    "create",
                    "extend",
                    "migrate",
                    "refactor",
                    "retire",
                    "reuse"
                  ]
                },
                "path_or_symbol": {
                  "minLength": 1,
                  "type": "string"
                },
                "reason": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "path_or_symbol",
                "disposition",
                "reason"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "assumption_refs": {
            "items": {
              "pattern": "^A[1-9][0-9]*$",
              "type": "string"
            },
            "type": "array"
          },
          "completion": {
            "additionalProperties": false,
            "properties": {
              "evidence": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array"
              },
              "state": {
                "enum": [
                  "incomplete",
                  "complete"
                ]
              }
            },
            "required": [
              "state",
              "evidence"
            ],
            "type": "object"
          },
          "dependencies": {
            "items": {
              "pattern": "^T[1-9][0-9]*(?:\\.[1-9][0-9]*){2,}$",
              "type": "string"
            },
            "type": "array"
          },
          "domains": {
            "items": {
              "pattern": "^\\{[A-Z0-9_]+\\}$",
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "epic_id": {
            "pattern": "^E[1-9][0-9]*$",
            "type": "string"
          },
          "estimated_hours": {
            "maximum": 16,
            "minimum": 1,
            "type": "integer"
          },
          "mitigation": {
            "minLength": 1,
            "type": "string"
          },
          "owner": {
            "minLength": 1,
            "type": "string"
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "raci": {
            "additionalProperties": false,
            "properties": {
              "A": {
                "type": "string"
              },
              "C": {
                "type": "string"
              },
              "I": {
                "type": "string"
              },
              "R": {
                "type": "string"
              }
            },
            "required": [
              "R",
              "A",
              "C",
              "I"
            ],
            "type": "object"
          },
          "repository_evidence": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "risk": {
            "minLength": 1,
            "type": "string"
          },
          "security_knowledge": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "application": {
                  "minLength": 1,
                  "type": "string"
                },
                "claim": {
                  "minLength": 1,
                  "type": "string"
                },
                "classification": {
                  "enum": [
                    "EVIDENCED",
                    "INFERRED",
                    "DEFENSIVE-SCENARIO",
                    "RAW-CHALLENGE",
                    "EXTERNAL-STANDARD",
                    "UNRESOLVED"
                  ]
                },
                "limitation": {
                  "type": "string"
                },
                "source": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "classification",
                "source",
                "claim",
                "application",
                "limitation"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "sequence": {
            "minimum": 1,
            "type": "integer"
          },
          "source_plan_mapping": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "steps": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 5,
            "minItems": 1,
            "type": "array"
          },
          "tags": {
            "items": {
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "task_id": {
            "pattern": "^T[1-9][0-9]*(?:\\.[1-9][0-9]*){2,}$",
            "type": "string"
          },
          "title": {
            "minLength": 3,
            "type": "string"
          },
          "v21": {
            "additionalProperties": false,
            "properties": {
              "acceptance": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              "current_state": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              "debugging": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              "design": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              "edge_cases": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              "implementation": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              "purpose": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              "repository_evidence": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              "security": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              "testing": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              "validation": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              "where": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              }
            },
            "required": [
              "purpose",
              "where",
              "repository_evidence",
              "current_state",
              "design",
              "implementation",
              "security",
              "edge_cases",
              "acceptance",
              "testing",
              "validation",
              "debugging"
            ],
            "type": "object"
          }
        },
        "required": [
          "sequence",
          "task_id",
          "epic_id",
          "title",
          "priority",
          "estimated_hours",
          "owner",
          "raci",
          "domains",
          "dependencies",
          "source_plan_mapping",
          "repository_evidence",
          "security_knowledge",
          "affected_components",
          "acceptance_criteria",
          "steps",
          "risk",
          "mitigation",
          "tags",
          "assumption_refs",
          "completion",
          "v21"
        ],
        "type": "object"
      },
      "minItems": 3,
      "type": "array"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "generator_version",
    "slug",
    "title",
    "evidence_mode",
    "target_repository",
    "target_plan_path",
    "planning_root",
    "part1_header_source",
    "source_repositories",
    "authorities",
    "domains",
    "epics",
    "assumptions",
    "conflicts",
    "master_plan",
    "tasks"
  ],
  "title": "BinReaper Canonical ATLAS Production TODO Registry",
  "type": "object"
}
